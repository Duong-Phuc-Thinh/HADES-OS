{
  "name": "hades-os",
  "version": "1.0.0",
  "description": "HADES OS — Futuristic Multi-Agent Personal AI Desktop Assistant for Windows 10/11",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "tsc -b && vite build",
    "dev:electron": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "ai",
    "desktop-agent",
    "gemini",
    "hades",
    "hud",
    "threejs",
    "electron"
  ],
  "author": "HADES OS Team",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.0.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.2",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.hades.os",
    "productName": "HADES OS",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  }
}
